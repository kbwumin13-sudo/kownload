{
  "manifest_version": 3,
  "name": "kownload 下载助手",
  "version": "0.4.0",
  "description": "将选中的网盘文件与网页媒体交给 kownload 下载",
  "key": "",
  "permissions": [
    "webRequest",
    "cookies",
    "storage",
    "tabs",
    "webNavigation",
    "nativeMessaging",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://pan.baidu.com/*", "*://yun.baidu.com/*",
        "*://www.aliyundrive.com/*", "*://www.alipan.com/*",
        "*://yun.139.com/*", "*://caiyun.139.com/*",
        "*://cloud.189.cn/*", "*://pan.xunlei.com/*",
        "*://pan.quark.cn/*", "*://drive.uc.cn/*",
        "*://*.123pan.com/*", "*://*.123pan.cn/*",
        "*://*.123684.com/*", "*://*.123865.com/*",
        "*://*.123952.com/*", "*://*.123912.com/*",
        "*://www.guangyapan.com/*"
      ],
      "js": ["netdisk-content.js"],
      "all_frames": false,
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle",
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "action": {
    "default_title": "kownload 下载助手",
    "default_popup": "popup.html"
  }
}
